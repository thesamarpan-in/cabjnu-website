# Copy this file to .env.local and fill in real values from your
# Supabase project dashboard (Project Settings -> API).
# .env.local is git-ignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Published-CSV URL of the Centre's plant-data Google Sheet (File -> Share
# -> Publish to web -> CSV). This is a public URL, not a secret, but keep
# it in .env.local for local builds; it also needs to be a GitHub Secret
# named PLANTS_SHEET_CSV_URL for the deploy workflow. See
# docs/data-entry-guide.md for full setup. Leave unset to build from
# whatever is currently in data/plants.json.
PLANTS_SHEET_CSV_URL=

# Google Apps Script Web App URL — handles both quiz-result logging and
# comment submission/moderation. See docs/apps-script-setup.md. Both can
# be the same URL. Leave unset and the quiz/comments UI still works,
# just without saving/showing data anywhere.
NEXT_PUBLIC_QUIZ_RESULTS_ENDPOINT=
NEXT_PUBLIC_COMMENTS_ENDPOINT=
